# Modèle de deploy/ovh/.env.vinasign (600, jamais versionné) : preparer-serveur.sh le crée avec des secrets tirés au hasard.
VINASIGN_DB_UTILISATEUR=vinasign
VINASIGN_DB_MDP=
VINASIGN_DB_MDP_APPLICATIF=
VINASIGN_AZURITE_CLE=
VINASIGN_CLE_CODES=
VINASIGN_CLE_CHIFFREMENT=
KEYCLOAK_DB_MDP=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_MDP=
# Adresses publiques
VINASIGN_URL_PUBLIQUE=https://vinasign.vinaitsolution.com
VINASIGN_SIGNATAIRE_URL=https://signer.vinasign.vinaitsolution.com
VINASIGN_ORIGINES_AUTORISEES=https://vinasign.vinaitsolution.com,https://signer.vinasign.vinaitsolution.com
VINASIGN_WEBAUTHN_RP_ID=signer.vinasign.vinaitsolution.com
VINASIGN_INSCRIPTION_URL=https://vinasign.vinaitsolution.com/inscription
VINASIGN_PAIEMENT_URL_RETOUR=https://vinasign.vinaitsolution.com/facturation
# Fournisseur d'identité du portail (Keycloak de la démonstration)
VINASIGN_PORTAIL_EMETTEUR=https://id.vinasign.vinaitsolution.com/realms/vinasign
VINASIGN_PORTAIL_AUDIENCE=api://vinasign
VINASIGN_PORTAIL_AMR_MFA=otp,mfa,hwk
# Démonstration : ni production (le cachet PKCS#12 y est refusé), ni bac à sable.
VINASIGN_ENVIRONNEMENT=demonstration
VINASIGN_INSCRIPTION_MODE=bac-a-sable
VINASIGN_SMS_FOURNISSEUR=simulateur
VINASIGN_JETONS_EMETTEUR=https://vinasign.vinaitsolution.com
VINASIGN_JETONS_AUDIENCE=https://vinasign.vinaitsolution.com/api
# Clé de signature des jetons : secrets/jetons.pem (PKCS#8), passée par deployer.sh, jamais dans ce fichier.
VINASIGN_ANTIVIRUS_HOTE=freelance-clamav
VINASIGN_ANTIVIRUS_PORT=3310
VINASIGN_EXPEDITEUR=ne-pas-repondre@vinasign.vinaitsolution.com
VINASIGN_DEBIT_ANONYME=120

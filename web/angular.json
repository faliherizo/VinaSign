            ],
            "tsConfig": "projects/signataire/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/signataire/public"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "pdfjs"
              }
            ],
            "styles": [
              "projects/signataire/src/styles.css"
            ],
            "codeCoverage": true,
            "karmaConfig": "projects/signataire/karma.conf.js"
          }
        }
      }
    },
    "commun": {
      "projectType": "library",
      "root": "projects/commun",
      "sourceRoot": "projects/commun/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/commun/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/commun/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/commun/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "karmaConfig": "projects/commun/karma.conf.js",
            "codeCoverage": true,
            "assets": [
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "pdfjs"
              }
            ]
          }
        }
      }
    }
  }
}

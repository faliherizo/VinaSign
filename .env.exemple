# Copier en .env (ignoré par git) et remplacer les valeurs. Aucun secret réel ici.
VINASIGN_DB_NOM=vinasign
VINASIGN_DB_UTILISATEUR=vinasign
VINASIGN_DB_MDP=a-remplacer
VINASIGN_DB_ROLE_APPLICATIF=vinasign_application
VINASIGN_DB_MDP_APPLICATIF=a-remplacer
VINASIGN_DB_PORT=55432
VINASIGN_PORT=8300
VINASIGN_LANGUE_PRINCIPALE=fr
VINASIGN_ORIGINES_AUTORISEES=http://localhost:4300,http://localhost:4301
VINASIGN_SWAGGER_UI=true
VINASIGN_JETONS_EMETTEUR=http://localhost:8300
VINASIGN_JETONS_AUDIENCE=http://localhost:8300/api
# Poste seulement : clé de jeton générée au démarrage. En exploitation, VINASIGN_JETONS_CLE_PRIVEE (Key Vault).
VINASIGN_JETONS_CLE_EPHEMERE=true
# Fournisseur OIDC du portail (VS-014) ; vide : seules les applications clientes accèdent à l'API.
VINASIGN_PORTAIL_EMETTEUR=
VINASIGN_PORTAIL_JWKS=
VINASIGN_PORTAIL_AUDIENCE=
# Débit d'une adresse sans authentification, par minute (VS-015) ; celui des organisations vient de leur plan.
VINASIGN_DEBIT_ANONYME=120
# Stockage des documents (VS-021) : Azurite sur un poste ; clé base64 générée (openssl rand -base64 32).
VINASIGN_AZURITE_CLE=a-remplacer
VINASIGN_STOCKAGE_PORT=21000
VINASIGN_STOCKAGE_CONNEXION="DefaultEndpointsProtocol=http;AccountName=vinasign;AccountKey=${VINASIGN_AZURITE_CLE};BlobEndpoint=http://localhost:${VINASIGN_STOCKAGE_PORT}/vinasign"
VINASIGN_ANTIVIRUS_PORT=23310
VINASIGN_URL_PUBLIQUE=http://localhost:8300
# Interface du signataire (liens d'invitation et sessions intégrées, VS-040, VS-046).
VINASIGN_SIGNATAIRE_URL=http://localhost:4301
# Clés générées sur le poste (openssl rand -base64 32), jamais réutilisées : HMAC des codes (VS-042), chiffrement des
# téléphones (VS-081). En exploitation : Key Vault.
VINASIGN_CLE_CODES=
VINASIGN_CLE_CHIFFREMENT=
# Courriels (Mailpit sur un poste, VS-080) ; SMS : « simulateur » sur un poste, fournisseur réel en exploitation.
VINASIGN_SMTP_HOTE=localhost
VINASIGN_SMTP_PORT=21025
VINASIGN_SMS_FOURNISSEUR=simulateur

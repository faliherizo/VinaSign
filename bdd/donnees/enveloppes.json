    "enveloppes.liste": {
      "description": "L'application liste ses enveloppes, les plus récentes d'abord, page par page (curseur opaque), filtrées par un statut du référentiel ; un curseur falsifié est refusé",
      "profil": "application",
      "etapes": [
        {
          "appel": "GET /api/v1/referentiels/mode-enveloppe",
          "capturer": {
            "mode": "$.valeurs[?code=document].code"
          }
        },
        {
          "appel": "GET /api/v1/referentiels/statut-enveloppe",
          "capturer": {
            "brouillon": "$.valeurs[?code=brouillon].code"
          }
        },
        {
          "appel": "POST /api/v1/envelopes",
          "entetes": {
            "Idempotency-Key": "bdd-a-${unique}"
          },
          "statut": 201,
          "corps": {
            "externalReference": "BDD-A-${unique}",
            "mode": "${mode}",
            "expiresAt": "${dansUnMois}T12:00:00Z"
          },
          "capturer": {
            "premiere": "$.id"
          }
        },
        {
          "appel": "POST /api/v1/envelopes",
          "entetes": {
            "Idempotency-Key": "bdd-b-${unique}"
          },
          "statut": 201,
          "corps": {
            "externalReference": "BDD-B-${unique}",
            "mode": "${mode}",
            "expiresAt": "${dansUnMois}T12:00:00Z"
          },
          "capturer": {
            "seconde": "$.id"
          }
        },
        {
          "appel": "GET /api/v1/envelopes?limite=1&statut=${brouillon}",
          "capturer": {
            "suivant": "$.suivant"
          },
          "verifier": [
            {
              "chemin": "$.elements[0].id",
              "egal": "${seconde}"
            },
            {
              "chemin": "$.suivant",
              "existe": true
            }
          ]
        },
        {
          "appel": "GET /api/v1/envelopes?limite=1&statut=${brouillon}&apres=${suivant}",
          "verifier": [
            {
              "chemin": "$.elements[0].id",
              "egal": "${premiere}"
            }
          ]
        },
        {
          "appel": "GET /api/v1/envelopes?apres=falsifie",
          "statut": 422
        }
      ]
    },

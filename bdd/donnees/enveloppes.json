    "signataire.parcours-ecran-verification": {
      "description": "Après la signature à l'écran, la plateforme finalise l'enveloppe : document final scellé, journal intègre, certificat de réalisation et dossier de preuve",
      "profil": "application",
      "etapes": [
        {
          "appel": "GET /api/v1/envelopes/${id}",
          "attendre": 90,
          "verifier": [
            {
              "chemin": "$.signataires[0].statut",
              "egal": "signe"
            },
            {
              "chemin": "$.statut",
              "egal": "terminee"
            }
          ]
        },
        {
          "appel": "GET /api/v1/envelopes/${id}/documents/final",
          "statut": 200
        },
        {
          "appel": "GET /api/v1/envelopes/${id}/preuve/integrite",
          "verifier": [
            {
              "chemin": "$.integre",
              "egal": true
            }
          ]
        },
        {
          "appel": "GET /api/v1/envelopes/${id}/preuve/certificat",
          "statut": 200
        },
        {
          "appel": "GET /api/v1/envelopes/${id}/preuve/dossier",
          "statut": 200
        },
        {
          "appel": "GET /api/v1/envelopes/${id}",
          "verifier": [
            {
              "chemin": "$.evenements[*].type",
              "inclut": "preuve-exportee"
            }
          ]
        }
      ]
    },

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Porte de couverture du code écrit à la main ; le client généré depuis le contrat est exclu (code généré). -->
    <CollectCoverage>true</CollectCoverage>
    <Threshold>96</Threshold>
    <ThresholdType>line</ThresholdType>
    <ExcludeByFile>**/Genere/*.cs</ExcludeByFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../VinaSign.Client/VinaSign.Client.csproj" />
  </ItemGroup>
</Project>

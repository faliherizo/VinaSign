<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ca.vinaitsolution</groupId>
    <artifactId>vinasign-serveur</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>VinaSign — serveur</name>
    <description>Plateforme de signature électronique opérée par Vina IT Solution (monolithe modulaire)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <springdoc.version>2.8.13</springdoc.version>
        <archunit.version>1.4.1</archunit.version>
        <jacoco.version>0.8.13</jacoco.version>
        <pitest.version>1.20.1</pitest.version>
        <pitest-junit5.version>1.2.2</pitest-junit5.version>
        <pdfbox.version>2.0.31</pdfbox.version>
        <azure-storage-blob.version>12.29.1</azure-storage-blob.version>
        <azure-identity.version>1.15.4</azure-identity.version>
        <azure-keyvault-keys.version>4.10.6</azure-keyvault-keys.version>
        <lowkey-vault.version>3.1.31</lowkey-vault.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <!-- Seuils bloquants (CLAUDE.md) : la construction échoue sous ces valeurs, ou si la couverture baisse. -->
        <couverture.lignes>0.96</couverture.lignes>
        <couverture.branches>0.92</couverture.branches>
        <mutation.seuil>80</mutation.seuil>
        <!-- La caractérisation du moteur exige les bacs à sable : elle s'exécute par le profil « caracterisation ». -->
        <excludedGroups>caracterisation</excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Stockage objet des documents (VS-021, VS-022) : Azure Blob, identité gérée en exploitation. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <version>${azure-storage-blob.version}</version>
        </dependency>
        <!-- Clés de cachet en HSM (VS-031) : Azure Key Vault Premium, clés non exportables. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-keys</artifactId>
            <version>${azure-keyvault-keys.version}</version>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>${azure-identity.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Courriels (VS-080) : relais SMTP ; Mailpit sur un poste et en test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Observabilité (VS-004) : traces et métriques OpenTelemetry, exportées en OTLP vers le collecteur. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Poste de développement : la base de infra/docker-compose.dev.yml est branchée sans identifiants dans la configuration. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Requis par la fabrique de clients de l'émulateur Key Vault (secrets, certificats). -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-secrets</artifactId>
            <version>4.9.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-certificates</artifactId>
            <version>4.8.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.nagyesta.lowkey-vault</groupId>
            <artifactId>lowkey-vault-client</artifactId>
            <version>${lowkey-vault.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.nagyesta.lowkey-vault</groupId>
            <artifactId>lowkey-vault-testcontainers</artifactId>
            <version>${lowkey-vault.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>azure</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Moteur de signature (VS-030 à VS-036) : mêmes bibliothèques et versions que le CLM, pour que la suite de
             caractérisation s'exécute à l'identique contre les deux moteurs. Portée test jusqu'au portage (VS-032). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Clés d'accès (WebAuthn, VS-043) : vérification des cérémonies ; émulateur d'authentificateur pour les tests. -->
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-core</artifactId>
            <version>0.29.5.RELEASE</version>
        </dependency>
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-test</artifactId>
            <version>0.29.5.RELEASE</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Le module docker-compose n'est pas embarqué dans l'artefact de production. -->
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-docker-compose</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- Point d'entrée main : aucune logique (exclusion nominative, CLAUDE.md). -->
                        <exclude>ca/vinaitsolution/vinasign/VinaSignApplication.class</exclude>
                        <!-- Clients Azure à identité gérée : construction seule, éprouvée par le déploiement (exclusion nominative, motif dans la classe). -->
                        <exclude>ca/vinaitsolution/vinasign/commun/infrastructure/IdentiteAzure.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>preparer</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>rapport</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>porte-couverture</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${couverture.lignes}</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>${couverture.branches}</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Domaine : logique pure, sans E/S — 100 % des lignes et des branches (CLAUDE.md). -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>ca.vinaitsolution.vinasign.*.domain</include></includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${couverture.lignes}</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Caractérisation du moteur de signature (VS-030) : juges externes (pyHanko, openssl, veraPDF) des bacs à sable,
             déclarés obligatoires ; les classes de production n'y sont pas mesurées (porte de couverture du build principal). -->
        <profile>
            <id>caracterisation</id>
            <properties>
                <groups>caracterisation</groups>
                <excludedGroups/>
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <vinasign.bacs-a-sable>obligatoires</vinasign.bacs-a-sable>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses><param>ca.vinaitsolution.vinasign.*</param></targetClasses>
                            <excludedClasses><param>ca.vinaitsolution.vinasign.VinaSignApplication</param></excludedClasses>
                            <mutationThreshold>${mutation.seuil}</mutationThreshold>
                            <outputFormats><param>HTML</param><param>XML</param></outputFormats>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>mutationCoverage</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
